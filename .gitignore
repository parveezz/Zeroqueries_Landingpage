# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Production build outputs
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage

# Environment & Secrets (ignore all .env files, but keep .env.example template)
.env*
!.env.example
*.pem
*.key
*.cert

# Uploads & Media generated at runtime (keep .gitkeep so directory exists)
/public/uploads/*
!/public/uploads/.gitkeep
/public/generated-assets.zip
*.zip
*.tar.gz

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# OS & Editor files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sublime-project
*.sublime-workspace

