# ========================================================
# ZeroQueries - Production Hostinger Apache / LiteSpeed Configuration
# Ensures Clean URLs, API Routing, SMTP Env, Security & Performance
# ========================================================

AddDefaultCharset UTF-8

# Hostinger SMTP Password Environment Variable
SetEnv HOSTINGER_SMTP_PASSWORD "Invertio@2026$"

<IfModule mod_mime.c>
    AddCharset UTF-8 .html .css .js .json .php
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType text/html .html
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Redirect www to non-www
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # 3. API Endpoint Routing (Clean URLs to PHP)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/blogs/([^/]+)/?$ api/blogs.php?slug=$1 [QSA,L]
    RewriteRule ^api/blogs/?$ api/blogs.php [QSA,L]
    RewriteRule ^api/contact/?$ api/contact.php [QSA,L]
    RewriteRule ^api/demo/?$ api/demo.php [QSA,L]
    RewriteRule ^api/newsletter/?$ api/newsletter.php [QSA,L]
    RewriteRule ^api/send_mail/?$ api/send_mail.php [QSA,L]

    # 4. 301 Redirects from Old v1 URLs to Current Website
    RewriteRule ^blog/?$ /resources [R=301,L]
    RewriteRule ^terms/?$ /tos [R=301,L]
    RewriteRule ^sub-processors/?$ /sub-processor [R=301,L]
    RewriteRule ^slack/support/?$ /support [R=301,L]
    RewriteRule ^partners/?$ /contact [R=301,L]

    # 5. Next.js Static Export Clean URLs (removes need for .html extension)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 6. Security: Protect sensitive configuration and SQL files from direct download
<FilesMatch "(schema\.sql|\.env|\.git|\.md)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 7. Enable CORS headers for API
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>

# 8. Enable Gzip Compression for Fast Page Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 9. Browser Cache Control for Static Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
